# ==========================================
# Environment variables / secrets
# (root .env and server/.env contain API keys,
#  SMTP credentials and Supabase keys)
# ==========================================
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key

# ==========================================
# Dependencies (root + server)
# ==========================================
node_modules/
**/node_modules/
.pnpm-store/
.yarn/*
!.yarn/releases
.npm/

# ==========================================
# Build output (Vite)
# ==========================================
dist/
dist-ssr/
build/
*.local
.vite/
*.tsbuildinfo

# ==========================================
# Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Caches / test coverage
# ==========================================
.cache/
.eslintcache
coverage/
.nyc_output/

# ==========================================
# Editor / IDE
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local settings
.claude/settings.local.json

# ==========================================
# OS files
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
